/*
 * Pipeline STAGING: build, tests, imágenes Docker, deploy a K8s y pruebas smoke/E2E.
 */

pipeline {
  agent any

  environment {
    ENVIRONMENT         = 'stage'
    PROJECT_VERSION     = "${env.BUILD_NUMBER ?: '0.1.0'}"
    JAVA_VERSION        = '11'
    MAVEN_OPTS          = '-Xmx3072m -XX:MaxPermSize=512m'

    KUBERNETES_CONTEXT  = "${env.KUBERNETES_CONTEXT ?: 'minikube'}"
    KUBECTL_NAMESPACE   = "${env.KUBECTL_NAMESPACE  ?: 'ecommerce-stage'}"

    USE_LOCAL_REGISTRY  = "${env.USE_LOCAL_REGISTRY ?: 'true'}"
    DOCKER_REGISTRY     = "${env.DOCKER_REGISTRY ?: 'localhost:5000'}"

    INFRASTRUCTURE_SERVICES = 'service-discovery,cloud-config'
    CORE_SERVICES           = 'api-gateway,proxy-client'
    BUSINESS_SERVICES       = 'user-service,product-service,favourite-service,order-service,payment-service,shipping-service'
    ALL_SERVICES            = "${INFRASTRUCTURE_SERVICES},${CORE_SERVICES},${BUSINESS_SERVICES}"
  }

  tools {
    maven 'Maven-3.8'   // ajusta al nombre real de tu instalación
    jdk   'JDK-11'
  }

  options {
    buildDiscarder(logRotator(numToKeepStr: '10'))
    timestamps()
    timeout(time: 90, unit: 'MINUTES')
    retry(1)
  }

  stages {

    stage('Preparación del Entorno') {
      steps {
        script {
          echo '=========================================='
          echo 'Pipeline STAGING - Build, Deploy & Test'
          echo '=========================================='
          echo "Versión del Build: ${PROJECT_VERSION}"
          echo "Branch: ${env.BRANCH_NAME}"
          echo "Commit: ${env.GIT_COMMIT}"
          echo "Entorno: ${ENVIRONMENT}"
          echo "Kubernetes Context: ${KUBERNETES_CONTEXT}"
          echo "Docker Registry: ${DOCKER_REGISTRY}"
          echo "Namespace: ${KUBECTL_NAMESPACE}"
          echo '=========================================='
        }

        // Herramientas
        sh '''#!/usr/bin/env bash
          set -e
          echo "Verificando herramientas..."
          ./mvnw --version || echo "⚠️  mvnw no disponible"

          if command -v docker >/dev/null; then
            echo "✅ Docker"
            docker --version
            docker ps >/dev/null 2>&1 || echo "⚠️  Docker CLI sin acceso al daemon"
          else
            echo "❌ Docker no está en el contenedor"; exit 1
          fi

          if command -v kubectl >/dev/null; then
            echo "✅ kubectl"
            kubectl version --client
          else
            echo "❌ kubectl no está en el contenedor"; exit 1
          fi

          command -v jq >/dev/null && jq --version || echo "⚠️  jq no instalado"
        '''

        // Kubeconfig limpio vía kubectl config set-*
        sh '''#!/usr/bin/env bash
          set -e
          echo "Configurando contexto de Kubernetes: $KUBERNETES_CONTEXT"

          # Si hay minikube en el contenedor, intenta IP; si no, usa valor por defecto
          MINIKUBE_IP="192.168.49.2"
          if command -v minikube >/dev/null 2>&1; then
            set +e
            MI=$(minikube ip 2>/dev/null)
            test -n "$MI" && MINIKUBE_IP="$MI"
            set -e
          fi
          echo "Usando API server: https://$MINIKUBE_IP:8443"

          # Rutas de certs esperadas dentro del contenedor
          CA=/root/.minikube/ca.crt
          CCRT=/root/.minikube/profiles/minikube/client.crt
          CKEY=/root/.minikube/profiles/minikube/client.key

          if [ ! -f "$CA" ] || [ ! -f "$CCRT" ] || [ ! -f "$CKEY" ]; then
            echo "❌ Certificados de minikube no encontrados en /root/.minikube"
            echo "Contenido disponible:"; ls -la /root/.minikube || true
            exit 1
          fi

          # Resetea kubeconfig sin sed/echo raros
          mkdir -p /root/.kube
          : > /root/.kube/config

          kubectl config set-cluster minikube \
            --server="https://$MINIKUBE_IP:8443" \
            --certificate-authority="$CA" \
            --embed-certs=false >/dev/null

          kubectl config set-credentials minikube \
            --client-certificate="$CCRT" \
            --client-key="$CKEY" \
            --embed-certs=false >/dev/null

          kubectl config set-context minikube \
            --cluster=minikube --user=minikube >/dev/null

          kubectl config use-context "$KUBERNETES_CONTEXT" >/dev/null || {
            echo "⚠️  No se pudo usar el contexto $KUBERNETES_CONTEXT; disponibles:"
            kubectl config get-contexts || true
          }

          echo "Verificando cluster-info…"
          kubectl cluster-info || { echo "❌ Sin acceso al cluster"; exit 1; }
          echo "✅ Acceso a Kubernetes verificado"
        '''

        // Registry hint (no toca config)
        sh '''#!/usr/bin/env bash
          if [ "$USE_LOCAL_REGISTRY" = "true" ]; then
            echo "Registry local habilitado: $DOCKER_REGISTRY"
            command -v minikube >/dev/null && minikube addons list | grep -i registry || echo "⚠️  Verifica addon registry en minikube"
          else
            echo "Registry remoto: $DOCKER_REGISTRY"
          fi
        '''
      }
    }

    stage('Checkout') {
      steps {
        checkout scm
        script {
          env.GIT_COMMIT_SHORT = sh(script: 'git rev-parse --short HEAD 2>/dev/null || echo N/A', returnStdout: true).trim()
        }
      }
    }

    stage('Validación y Pruebas') {
      parallel {
        stage('Validación de Código') {
          steps {
            sh '''#!/usr/bin/env bash
              ./mvnw validate -q || true
            '''
          }
        }
        stage('Instalación de Dependencias') {
          steps {
            sh '''#!/usr/bin/env bash
              ./mvnw clean install -N -q
            '''
          }
        }
      }
    }

    stage('Pruebas Unitarias y Cobertura') {
      steps {
        echo 'Ejecutando pruebas unitarias + JaCoCo (≥50%)'
        sh '''#!/usr/bin/env bash
          set -e
          failed=0
          for service in user-service product-service order-service favourite-service payment-service shipping-service; do
            echo ">>> $service"
            if ./mvnw -q -pl "$service" clean test jacoco:report verify; then
              echo "✅ $service OK"
            else
              echo "❌ $service FAIL"; failed=$((failed+1))
            fi
          done
          [ $failed -eq 0 ] || { echo "❌ $failed servicio(s) no cumplen"; exit 1; }
        '''
      }
      post {
        always {
          junit '**/target/surefire-reports/TEST-*.xml'
          archiveArtifacts artifacts: '**/target/site/jacoco/**/*', allowEmptyArchive: true
        }
      }
    }

    stage('Construcción de Artefactos') {
      steps {
        sh '''#!/usr/bin/env bash
          set -e
          ./mvnw clean package -DskipTests
          find . -name "*.jar" -path "*/target/*" -not -name "*-original.jar" | sort
        '''
        archiveArtifacts artifacts: '**/target/*.jar', allowEmptyArchive: false, excludes: '**/target/*-original.jar'
      }
    }

    stage('Construcción de Imágenes Docker') {
      steps {
        script {
          for (svc in env.ALL_SERVICES.split(',')) {
            withEnv(["SVC=${svc}"]) {
              sh '''#!/usr/bin/env bash
                set -e
                echo "Docker build: $SVC"
                docker build \
                  -t "$DOCKER_REGISTRY/$SVC-ecommerce-boot:$PROJECT_VERSION" \
                  -t "$DOCKER_REGISTRY/$SVC-ecommerce-boot:latest" \
                  --build-arg PROJECT_VERSION="$PROJECT_VERSION" \
                  -f "$SVC/Dockerfile" .
              '''
            }
          }
        }
      }
    }

    stage('Push de Imágenes Docker') {
      when { anyOf { branch 'develop'; branch 'stage'; branch 'main' } }
      steps {
        script {
          if (env.USE_LOCAL_REGISTRY == 'true') {
            echo 'Registry local: se omite push (imágenes locales)'
          } else {
            withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
              sh '''#!/usr/bin/env bash
                set -e
                echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
              '''
              for (svc in env.ALL_SERVICES.split(',')) {
                withEnv(["SVC=${svc}"]) {
                  sh '''#!/usr/bin/env bash
                    set -e
                    docker push "$DOCKER_REGISTRY/$SVC-ecommerce-boot:$PROJECT_VERSION"
                    docker push "$DOCKER_REGISTRY/$SVC-ecommerce-boot:latest"
                  '''
                }
              }
            }
          }
        }
      }
    }

    stage('Despliegue en Kubernetes (Staging)') {
      steps {
        sh '''#!/usr/bin/env bash
          set -e
          echo "Creando namespace $KUBECTL_NAMESPACE si no existe…"
          kubectl create namespace "$KUBECTL_NAMESPACE" --dry-run=client -o yaml | kubectl apply -f -
        '''

        // Apply manifiestos
        sh '''#!/usr/bin/env bash
          set -e
          echo "Aplicando k8s/stage …"
          if command -v kustomize >/dev/null 2>&1; then
            echo "Usando kustomize build"
            kubectl apply -k k8s/stage/
          else
            echo "⚠️  kustomize CLI no está; intentando 'kubectl apply -k'"
            kubectl apply -k k8s/stage/
          fi
        '''

        // Espera pods listos
        sh '''#!/usr/bin/env bash
          set -e
          echo "Esperando pods listos en $KUBECTL_NAMESPACE…"
          timeout=600; elapsed=0
          while [ $elapsed -lt $timeout ]; do
            total=$(kubectl get pods -n "$KUBECTL_NAMESPACE" --no-headers 2>/dev/null | wc -l || echo 0)
            ready=$(kubectl get pods -n "$KUBECTL_NAMESPACE" -o jsonpath='{.items[*].status.conditions[?(@.type=="Ready")].status}' | grep -o True | wc -l || echo 0)
            [ "$total" -gt 0 ] && [ "$ready" -eq "$total" ] && { echo "✅ Pods listos ($ready/$total)"; break; }
            echo "Aún esperando… ($ready/$total)"; sleep 10; elapsed=$((elapsed+10))
          done
          [ $elapsed -lt $timeout ] || { echo "❌ Timeout esperando pods"; kubectl get pods -n "$KUBECTL_NAMESPACE"; exit 1; }
          kubectl get services -n "$KUBECTL_NAMESPACE"
          kubectl get pods -n "$KUBECTL_NAMESPACE" -o wide
        '''
      }
    }

    stage('Configuración de Port-Forward') {
      steps {
        sh '''#!/usr/bin/env bash
          set -e
          pkill -f "kubectl port-forward" || true
          sleep 2
          kubectl port-forward -n "$KUBECTL_NAMESPACE" service/api-gateway 8080:8080 >/dev/null 2>&1 &
          echo $! >/tmp/port-forward.pid
          sleep 5
          for i in {1..10}; do
            if curl -fs http://localhost:8080/actuator/health >/dev/null; then
              echo "✅ API Gateway accesible"
              break
            fi
            echo "Esperando API Gateway… ($i/10)"; sleep 3
          done
        '''
      }
    }

    stage('Health Checks - Servicios Desplegados') {
      steps {
        sh '''#!/usr/bin/env bash
          set -e
          kubectl get pods -n "$KUBECTL_NAMESPACE" -o wide
          kubectl get services -n "$KUBECTL_NAMESPACE"
          for pod in $(kubectl get pods -n "$KUBECTL_NAMESPACE" -o jsonpath='{.items[*].metadata.name}'); do
            echo "--- $pod ---"
            kubectl logs -n "$KUBECTL_NAMESPACE" "$pod" --tail=5 || true
          done
        '''
      }
    }

    stage('Pruebas Smoke') {
      steps {
        sh '''#!/usr/bin/env bash
          set -e
          sleep 10
          curl -f http://localhost:8080/actuator/health

          kubectl port-forward -n "$KUBECTL_NAMESPACE" service/service-discovery 8761:8761 >/dev/null 2>&1 &
          sleep 3
          curl -fs http://localhost:8761/actuator/health || echo "⚠️  Eureka no responde"
          pkill -f "kubectl port-forward.*service-discovery" || true

          for ep in \
            "/user-service/api/users" \
            "/product-service/api/products"
          do
            code=$(curl -s -o /dev/null -w "%{http_code}" "http://localhost:8080$ep" || echo 000)
            case "$code" in 200|401|404) echo "✅ $ep ($code)";; *) echo "⚠️  $ep ($code)";; esac
          done
        '''
      }
    }

    stage('Pruebas E2E') {
      steps {
        sh '''#!/usr/bin/env bash
          set +e
          SPRING_PROFILES_ACTIVE=stage API_GATEWAY_URL=http://localhost:8080 \
            ./mvnw test -Dtest="*E2ETest" -Dspring.profiles.active=stage -Dapi.gateway.url=http://localhost:8080
          exit 0
        '''
      }
      post {
        always {
          junit '**/target/surefire-reports/TEST-*E2ETest.xml'
          archiveArtifacts artifacts: '**/target/surefire-reports/**/*', allowEmptyArchive: true
        }
      }
    }

    stage('Pruebas de Integración') {
      steps {
        sh '''#!/usr/bin/env bash
          set +e
          SPRING_PROFILES_ACTIVE=stage API_GATEWAY_URL=http://localhost:8080 \
            ./mvnw test -Dtest="*IntegrationTest" -Dspring.profiles.active=stage -Dapi.gateway.url=http://localhost:8080
          exit 0
        '''
      }
      post {
        always {
          junit '**/target/surefire-reports/TEST-*IntegrationTest.xml'
          archiveArtifacts artifacts: '**/target/surefire-reports/**/*', allowEmptyArchive: true
        }
      }
    }

    stage('Validación Final') {
      steps {
        sh '''#!/usr/bin/env bash
          set -e
          kubectl get pods -n "$KUBECTL_NAMESPACE" -o wide
          kubectl get services -n "$KUBECTL_NAMESPACE"
          for ep in "/user-service/api/users" "/product-service/api/products" "/order-service/api/orders"; do
            code=$(curl -s -o /dev/null -w "%{http_code}" "http://localhost:8080$ep" || echo 000)
            case "$code" in 200|401|404) echo "✅ $ep ($code)";; *) echo "⚠️  $ep ($code)";; esac
          done
          echo "✅ Validación final OK"
        '''
      }
    }
  }

  post {
    always {
      sh '''#!/usr/bin/env bash
        echo "Limpiando port-forwards…"
        pkill -f "kubectl port-forward" || true
        rm -f /tmp/port-forward.pid || true
      '''
    }
    success {
      script {
        echo """
==========================================
Pipeline STAGING - ÉXITO
Build: ${env.BUILD_NUMBER}
Versión: ${PROJECT_VERSION}
Branch: ${env.BRANCH_NAME}
Commit: ${env.GIT_COMMIT_SHORT}
Entorno: ${ENVIRONMENT}
Kubernetes: context=${KUBERNETES_CONTEXT} ns=${KUBECTL_NAMESPACE} registry=${DOCKER_REGISTRY}
==========================================
"""
      }
    }
    failure {
      echo '❌ Pipeline STAGING falló'
      sh '''#!/usr/bin/env bash
        echo "Diagnóstico rápido…"
        kubectl get pods -n "$KUBECTL_NAMESPACE" -o wide || true
        kubectl get events -n "$KUBECTL_NAMESPACE" --sort-by=.lastTimestamp | tail -n 30 || true
      '''
    }
    unstable { echo '⚠️  Pipeline STAGING con advertencias' }
  }
}
